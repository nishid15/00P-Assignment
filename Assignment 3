#include <iostream>
#include <string>
using namespace std;

class employee {
public:
    int ID;
    int Salary;
    string Employename;
    string Employedepartmentname;

    void display() {
        cout << "---- Employee Details ----" << endl;
        cout << "ID: " << ID << endl;
        cout << "Salary: " << Salary << endl;
        cout << "Employee Name: " << Employename << endl;
        cout << "Employee Department Name: " << Employedepartmentname << endl;
    }
};

int main() {
    employee e1;

    e1.ID = 10202;
    e1.Salary = 95000;
    e1.Employename = "Rohan Varma";
    e1.Employedepartmentname = "AIML";

    e1.display();

    return 0;
}
